
public class Encap {
	
	 String name;
	 int age;
	
	public void setName(String n) {
		this.name=n;
	}
	
	public void setAge(int a) {
		this.age=a;
	}
	
	public String getName() {
		return name;
	}
	
	public int getAge() {
		return age;
	}
	
	public static void main(String[] args) {
		
		Encap n = new Encap();
		
		n.setName("Guru");
		n.setAge(15);
		
		System.out.println(n.getName());
		System.out.println(n.getAge());
		
	}
}
